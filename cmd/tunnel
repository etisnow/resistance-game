#!/usr/bin/env bash
#
# Cloudflare named-tunnel provisioning for nechto (ported from grailgun's
# cmd/worktree/lib/cloudflare.sh, scaled to two services).
#
#   client : ${CLIENT_HOST}  -> http://client:5173   (vite)
#   api    : ${API_HOST}     -> http://server:3000   (bun socket.io)
#
# Usage: cmd/tunnel <up|down|status>
#
set -euo pipefail
cd "$(dirname "$0")/.."

# Load .env (CLOUDFLARE_*, *_HOST, PROJECT_NAME, ROOT_HOST).
[ -f .env ] || { echo "Missing .env (Cloudflare creds)"; exit 1; }
set -a; . ./.env; set +a

: "${CLOUDFLARE_API_TOKEN:?set in .env}"
: "${CLOUDFLARE_ACCOUNT_ID:?set in .env}"
: "${CLOUDFLARE_ZONE_ID:?set in .env}"
PROJECT_NAME="${PROJECT_NAME:-nechto}"
ROOT_HOST="${ROOT_HOST:-estaco.my}"
CLIENT_HOST="${CLIENT_HOST:-${PROJECT_NAME}.${ROOT_HOST}}"
API_HOST="${API_HOST:-api-${PROJECT_NAME}.${ROOT_HOST}}"
TUNNEL_NAME="${PROJECT_NAME}-tunnel"

API="https://api.cloudflare.com/client/v4"
auth=(-H "Authorization: Bearer ${CLOUDFLARE_API_TOKEN}")
json=(-H "Content-Type: application/json")

say()  { echo -e "\033[0;34mℹ️  $*\033[0m"; }
ok()   { echo -e "\033[0;32m✅ $*\033[0m"; }
err()  { echo -e "\033[0;31m❌ $*\033[0m" >&2; }

cf() { curl -s "${auth[@]}" "$@"; }

tunnel_id_by_name() {
  cf "${API}/accounts/${CLOUDFLARE_ACCOUNT_ID}/cfd_tunnel?name=${TUNNEL_NAME}&is_deleted=false" \
    | jq -r '.result[0].id // empty'
}

tunnel_token() { # args: id
  cf "${API}/accounts/${CLOUDFLARE_ACCOUNT_ID}/cfd_tunnel/$1/token" | jq -r '.result'
}

create_tunnel() {
  local resp id
  resp=$(cf "${API}/accounts/${CLOUDFLARE_ACCOUNT_ID}/cfd_tunnel" "${json[@]}" \
    --data "{\"name\":\"${TUNNEL_NAME}\",\"config_src\":\"cloudflare\"}")
  [ "$(echo "$resp" | jq -r '.success')" = "true" ] || { err "create tunnel: $(echo "$resp" | jq -r '.errors[0].message')"; return 1; }
  echo "$resp" | jq -r '.result.id'
}

configure_ingress() { # args: id
  local id="$1"
  local ingress
  ingress=$(jq -n \
    --arg client "$CLIENT_HOST" \
    --arg api "$API_HOST" \
    '{config:{ingress:[
        {hostname:$client, service:"http://client:5173"},
        {hostname:$api,    service:"http://server:3000"},
        {service:"http_status:404"}
     ]}}')
  local resp
  resp=$(cf "${API}/accounts/${CLOUDFLARE_ACCOUNT_ID}/cfd_tunnel/${id}/configurations" "${json[@]}" \
    -X PUT --data "$ingress")
  [ "$(echo "$resp" | jq -r '.success')" = "true" ] || { err "configure ingress: $(echo "$resp" | jq -r '.errors[0].message')"; return 1; }
  ok "ingress configured (${CLIENT_HOST}, ${API_HOST})"
}

dns_upsert() { # args: name, id
  local name="$1" id="$2" content="$2.cfargotunnel.com" rid
  rid=$(cf "${API}/zones/${CLOUDFLARE_ZONE_ID}/dns_records?name=${name}" | jq -r '.result[0].id // empty')
  local body
  body=$(jq -n --arg name "$name" --arg content "$content" \
    '{type:"CNAME", name:$name, content:$content, ttl:1, proxied:true}')
  local resp
  if [ -n "$rid" ]; then
    resp=$(cf "${API}/zones/${CLOUDFLARE_ZONE_ID}/dns_records/${rid}" "${json[@]}" -X PUT --data "$body")
  else
    resp=$(cf "${API}/zones/${CLOUDFLARE_ZONE_ID}/dns_records" "${json[@]}" -X POST --data "$body")
  fi
  [ "$(echo "$resp" | jq -r '.success')" = "true" ] || { err "dns ${name}: $(echo "$resp" | jq -r '.errors[0].message')"; return 1; }
  ok "DNS ${name} -> ${content}"
}

dns_delete() { # args: name
  local name="$1" rid
  rid=$(cf "${API}/zones/${CLOUDFLARE_ZONE_ID}/dns_records?name=${name}" | jq -r '.result[0].id // empty')
  [ -n "$rid" ] || { say "DNS ${name} absent"; return 0; }
  cf "${API}/zones/${CLOUDFLARE_ZONE_ID}/dns_records/${rid}" -X DELETE >/dev/null
  ok "DNS ${name} deleted"
}

write_token_env() { # args: token
  local token="$1"
  if grep -q '^CLOUDFLARE_TUNNEL_TOKEN=' .env; then
    sed -i "s#^CLOUDFLARE_TUNNEL_TOKEN=.*#CLOUDFLARE_TUNNEL_TOKEN=${token}#" .env
  else
    echo "CLOUDFLARE_TUNNEL_TOKEN=${token}" >> .env
  fi
  ok "tunnel token written to .env"
}

cmd_up() {
  local id
  id=$(tunnel_id_by_name)
  if [ -n "$id" ]; then
    say "Reusing existing tunnel ${TUNNEL_NAME} (${id})"
  else
    say "Creating tunnel ${TUNNEL_NAME}"
    id=$(create_tunnel)
    ok "tunnel created (${id})"
  fi
  configure_ingress "$id"
  dns_upsert "$CLIENT_HOST" "$id"
  dns_upsert "$API_HOST" "$id"
  write_token_env "$(tunnel_token "$id")"
  echo
  ok "Tunnel ready:"
  echo "    client : https://${CLIENT_HOST}"
  echo "    api    : https://${API_HOST}"
}

cmd_down() {
  dns_delete "$CLIENT_HOST"
  dns_delete "$API_HOST"
  local id
  id=$(tunnel_id_by_name)
  if [ -n "$id" ]; then
    local resp
    resp=$(cf "${API}/accounts/${CLOUDFLARE_ACCOUNT_ID}/cfd_tunnel/${id}" -X DELETE)
    [ "$(echo "$resp" | jq -r '.success')" = "true" ] && ok "tunnel ${TUNNEL_NAME} deleted" \
      || err "delete tunnel: $(echo "$resp" | jq -r '.errors[0].message')"
  else
    say "tunnel ${TUNNEL_NAME} absent"
  fi
  write_token_env ""
}

cmd_status() {
  local id; id=$(tunnel_id_by_name)
  if [ -z "$id" ]; then echo "tunnel ${TUNNEL_NAME}: not created"; return 0; fi
  echo "tunnel ${TUNNEL_NAME}: ${id}"
  cf "${API}/accounts/${CLOUDFLARE_ACCOUNT_ID}/cfd_tunnel/${id}/configurations" \
    | jq -r '.result.config.ingress[] | select(.hostname) | "  \(.hostname) -> \(.service)"'
}

case "${1:-}" in
  up)     cmd_up ;;
  down)   cmd_down ;;
  status) cmd_status ;;
  *) echo "Usage: cmd/tunnel <up|down|status>"; exit 1 ;;
esac
