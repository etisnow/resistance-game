# Пример окружения. Скопируй в .env и подставь свои значения.

# --- Игра ---
# Публичные хосты, на которые смотрит созданный вручную Cloudflare-туннель.
CLIENT_HOST=nechto.example.com
API_HOST=api-nechto.example.com
# Токен коннектора туннеля (Cloudflare -> Tunnels -> Install connector).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Аналитический центр (analytics/) ---
# Публичные хосты аналитики (отдельные домены за тем же туннелем):
# витрина и её API.
ANALYTICS_HOST_PUBLIC=analytics-nechto.example.com
ANALYTICS_API_HOST=analytics-server-nechto.example.com
# Общий секрет: без него игровой сервер не сможет отправлять партии, а
# аналитика — их принимать. Придумай длинную случайную строку.
ANALYTICS_TOKEN=
# Пароль админки статистики. Пусто — админка выключена.
ANALYTICS_ADMIN_TOKEN=
# Куда игровой сервер шлёт партии. По умолчанию — сервис в докере.
# ANALYTICS_URL=http://analytics-server:3200
# Через сколько миллисекунд тишины статус считается выбранным (прокрутка метки
# по кружку игрока). После смены — «Пересчитать статусы» в админке.
# ANALYTICS_MARK_SETTLE_MS=10000
