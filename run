#!/usr/bin/env bash
#
# Nechto task runner. Bun is the package manager/runtime; vite is the client
# dev server + bundler; both the client (vite) and the backend (bun socket.io)
# run as Docker services. Usage: ./run <command>
#
set -euo pipefail
cd "$(dirname "$0")"

PORT="${PORT:-3000}"            # backend port
CLIENT_PORT="${CLIENT_PORT:-5173}"
export PORT CLIENT_PORT

DC="docker compose -f docker-compose.yml"
DCP="docker compose -f docker-compose.prod.yml"
# Аналитический центр поднимается тем же дев-компоузом, но отдельным профилем:
# играть можно и без него, а статистика при этом просто не собирается.
DCA="docker compose -f docker-compose.yml --profile analytics"

# Hostnames / tunnel token (docker compose reads .env on its own; we need
# CLIENT_HOST / API_HOST here too).
if [ -f .env ]; then set -a; . ./.env; set +a; fi

# Порты аналитики — после .env, чтобы её значения побеждали.
ANALYTICS_PORT="${ANALYTICS_PORT:-3200}"
ANALYTICS_WEB_PORT="${ANALYTICS_WEB_PORT:-5174}"
export ANALYTICS_PORT ANALYTICS_WEB_PORT

# Poll an HTTP endpoint until it answers. args: url label [timeout_s]
wait_http() {
  local url="$1" label="$2" timeout="${3:-60}" i=0
  printf '  %-9s %-46s ' "$label" "$url"
  while [ "$i" -lt "$timeout" ]; do
    if curl -sfo /dev/null --max-time 3 "$url"; then echo "ok"; return 0; fi
    printf '.'; sleep 1; i=$((i + 1))
  done
  echo " TIMEOUT (${timeout}s)"
  return 1
}

usage() {
  cat <<'EOF'
Nechto — ./run <command>

One button:
  go             Deps + the whole dev stack (игра + аналитика) в фоне; ждёт,
                 пока ответят и localhost, и публичные хосты туннеля

Docker (client = vite, server = bun, tunnel = cloudflared):
  up [args]      Start the dev stack in the foreground (streams logs)
  down [args]    Stop the dev stack
  logs [svc]     Follow logs (optionally one service: client | server | tunnel)
  restart [svc]  Restart services
  ps             List services
  prod <cmd>     Prod stack via docker-compose.prod.yml
                   prod up | prod down | prod build | prod logs

Аналитика (пакет analytics/):
  analytics <cmd>               ЗАМОРОЖЕН до фазы 4 — см. docs/PLAN.md

Local (no Docker):
  install        bun install + Playwright chromium
  server         Run the backend (bun) from source, hot reload
  client         Run the vite dev server (proxies socket.io to :3000)
  build          Build client (vite) + server (bun) into dist/
  build:client   vite build -> dist/client
  build:server   bundle the bun server -> dist/server
  start          Run the bundled server (serves dist/client)
  test           Run the unit test suite (bun test)
  e2e            Build client, run Playwright browser e2e tests
  typecheck      tsc --noEmit
  clean          Remove dist/ and build output
  help           Show this help
EOF
}

# Discover the unit tests under src (scoped to src so bun never picks up the
# Playwright e2e *.test.ts specs under e2e/).
unit_files() { find src -name '*.test.ts' | sed 's,^,./,'; }

cmd="${1:-help}"
shift || true

case "$cmd" in
  # ---- One button: the whole dev stack, publicly reachable ----
  go|all)
    : "${CLOUDFLARE_TUNNEL_TOKEN:?set in .env (Cloudflare dashboard -> Tunnels -> connector token)}"
    : "${CLIENT_HOST:?set in .env}" "${API_HOST:?set in .env}"
    [ -x node_modules/.bin/vite ] || bun install
    # Только игра: аналитический центр заморожен до фазы 4 (см. ниже).
    $DC up -d --remove-orphans "$@"
    echo
    echo "Waiting for services:"
    rc=0
    wait_http "http://localhost:${PORT}/socket.io/?EIO=4&transport=polling" server 60 || rc=1
    wait_http "http://localhost:${CLIENT_PORT}" client 60 || rc=1
    wait_http "https://${CLIENT_HOST}" public 90 || rc=1
    echo
    echo "Up:"
    echo "  local   : http://localhost:${CLIENT_PORT}"
    echo "  client  : https://${CLIENT_HOST}"
    echo "  api     : https://${API_HOST}"
    [ "$rc" -eq 0 ] || echo "  something did not come up — ./run logs"
    exit "$rc" ;;
  # ---- Docker (dev) ----
  # up — только игра; всё остальное с профилем analytics, иначе `down` оставил бы
  # аналитические контейнеры висеть (и не смог бы убрать сеть проекта).
  up|dev)    exec $DC up --remove-orphans "$@" ;;
  down)      exec $DCA down --remove-orphans "$@" ;;
  logs)      exec $DCA logs -f "$@" ;;
  restart)   exec $DCA restart "$@" ;;
  ps)        exec $DCA ps "$@" ;;
  # ---- Docker (prod) ----
  prod)
    sub="${1:-up}"; shift || true
    case "$sub" in
      up)    exec $DCP up --build "$@" ;;
      down)  exec $DCP down "$@" ;;
      build) exec $DCP build "$@" ;;
      logs)  exec $DCP logs -f "$@" ;;
      *)     exec $DCP "$sub" "$@" ;;
    esac ;;
  # ---- Аналитика ----
  # Пакет analytics/ заморожен: он весь построен на событиях «Нечто» (заражения,
  # сожжения, карты), а игровой сервер их больше не шлёт и общего контракта
  # больше нет — по нему пакет и не собирается. Переделывать его под голоса,
  # составы команд и исходы миссий или выбросить — решается в фазе 4
  # (см. docs/PLAN.md, открытые вопросы). До тех пор команда честно об этом
  # говорит, а не падает грудой ошибок компиляции.
  analytics|stats)
    echo "Аналитический центр заморожен до фазы 4 — см. docs/PLAN.md." >&2
    echo "Чтобы всё же его запустить, убери этот выход из ./run." >&2
    exit 1
    sub="${1:-help}"; shift || true
    # Сервисы аналитики живут в профиле, поэтому называем их явно: обычный
    # `./run up` их не трогает, а `./run analytics down` не гасит игру.
    case "$sub" in
      up)   exec $DCA up --remove-orphans analytics-server analytics-web "$@" ;;
      down) exec $DCA stop analytics-server analytics-web "$@" ;;
      logs) exec $DCA logs -f analytics-server analytics-web "$@" ;;
      *) : ;;
    esac
    cd analytics
    case "$sub" in
      server)    exec bun run --hot src/server/index.ts ;;
      web)       exec bunx vite ;;
      build)     exec bunx vite build ;;
      migrate)   exec bun run src/db/migrate.ts ;;
      seed)      exec bun run src/db/seed.ts ;;
      generate)  exec bunx drizzle-kit generate ;;
      typecheck) exec bunx tsc --noEmit ;;
      test)      exec bun test src ;;
      *) echo "Unknown analytics command: $sub" >&2; exit 1 ;;
    esac ;;
  # ---- Local ----
  install)
    bun install
    bunx playwright install --with-deps chromium ;;
  server)        exec bun run --hot src/server/index.ts ;;
  client)        exec bunx vite --host 0.0.0.0 --port "$CLIENT_PORT" ;;
  build:client)  exec bunx vite build ;;
  build:server)  exec bun run scripts/buildServer.ts ;;
  build)
    bunx vite build
    bun run scripts/buildServer.ts ;;
  start)
    [ -d dist/client ] || bunx vite build
    [ -f dist/server/index.js ] || bun run scripts/buildServer.ts
    exec bun dist/server/index.js ;;
  test)
    # shellcheck disable=SC2046
    bun test $(unit_files) "$@" ;;
  e2e)
    bunx vite build
    bunx playwright test "$@" ;;
  typecheck)     exec bunx tsc --noEmit ;;
  clean)         rm -rf dist build coverage && echo "cleaned" ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: $cmd" >&2; usage; exit 1 ;;
esac
